# Colors are Bearded Monokai Reversed, read out of the zed theme of the same names.

font = JetBrainsMono Nerd Font
font-size = 14

anchor = center
width = 640
height = 480
num-results = 13
result-spacing = 4
fuzzy-match = true

background-color = #12141a
border-width = 1
border-color = #78dce8
outline-width = 0
corner-radius = 8
padding-top = 16
padding-bottom = 16
padding-left = 24
padding-right = 24

text-color = #c6cad7
prompt-text = "❯  "
prompt-color = #a9dc76
placeholder-color = #a9aec1
input-color = #ffd866

default-result-color = #c6cad7
selection-color = #12141a
selection-background = #78dce8
selection-background-padding = 2,8
selection-background-corner-radius = 4
selection-match-color = #ffd866
