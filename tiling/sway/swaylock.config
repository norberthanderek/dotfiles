# Bearded Monokai Reversed.
color=12141a
image=~/.dotfiles/misc/wallpapers/robot-stalenhag-lock.png
scaling=fill

indicator-radius=64
indicator-thickness=8
font=JetBrainsMono Nerd Font
font-size=16

# Not transparent, that exposes an antialiasing seam.
# Not ring-coloured, rings outgrow segments.
line-uses-inside
separator-color=00000000

# Idle
ring-color=12141add
inside-color=12141add
text-color=c6cad7

# Typing
key-hl-color=a9dc76
bs-hl-color=ffd866

# Verifying
ring-ver-color=78dce8
inside-ver-color=12141add
text-ver-color=78dce8

# Caps lock, whose text would otherwise default to swaylock's stock amber
text-caps-lock-color=ffd866

# Wrong
ring-wrong-color=ff6188
inside-wrong-color=12141add
text-wrong-color=ff6188

# Cleared
ring-clear-color=ab9df2
inside-clear-color=12141add
text-clear-color=ab9df2
