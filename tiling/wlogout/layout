{
    "label" : "lock",
    "action" : "swaylock -f",
    "text" : "  lock",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "swaymsg exit",
    "text" : "  logout",
    "keybind" : "e"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "  suspend",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "  reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "  shutdown",
    "keybind" : "s"
}
